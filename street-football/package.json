{
  "name": "rua10-street-football",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare-characters": "node tools/prepare-characters.mjs",
    "test": "playwright test",
    "verify:visual": "playwright test tests/visual.spec.js",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "package": "vite build && python3 tools/package.py",
    "bench": "echo \"Open the game with ?bench (e.g. npm run preview, then http://127.0.0.1:4188/?bench)\"",
    "build:single": "vite build --config vite.singlefile.config.js"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-wasm": "^3.6.0"
  },
  "description": "RUA 10 — 3D arcade street football for the browser (Three.js + Rapier)."
}
